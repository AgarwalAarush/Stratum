SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
ALPACA_API_KEY_ID=""
ALPACA_API_SECRET_KEY=""
ALPACA_DATA_FEED="delayed_sip"
ALPACA_TRADING_URL="https://paper-api.alpaca.markets"
FMP_API_KEY=""
# Recommended for unattended automation. Alternatively authenticate this trusted host with `codex login --device-auth`.
CODEX_API_KEY=""
CODEX_SYNTHESIS_MODEL="gpt-5.6-terra"
CODEX_SYNTHESIS_ENABLED="true"
WORKER_ID="stratum-macserver-1"
WORKER_POLL_INTERVAL_MS="5000"
# Parallel claim/execute slots for cheap and standard jobs. Cap is 4.
STRATUM_WORKER_CONCURRENCY="2"
# Unattended strong research pairs per orchestration cycle (default 2).
STRATUM_MARKET_RESEARCH_RUN_LIMIT="2"
WORKER_SCHEDULER_ENABLED="true"
WORKER_SCHEDULER_INTERVAL_MS="60000"
# Private market-memory corpus. Never point this at a developer checkout.
STRATUM_DATA_ROOT="/Users/Shared/StratumData"
STRATUM_WORLD_ROOT="/Users/Shared/StratumData/world-model"
STRATUM_WORLD_GIT_REMOTE="git@github.com:AgarwalAarush/StratumWorld.git"
STRATUM_WORLD_BRANCH="shadow/world-thinker"
STRATUM_WORLD_THINKER_ENABLED="true"
# Keep false for the entire 48-hour shadow. Promotion requires every gate in
# docs/plans/2026-08-17-world-thinker-production.md.
STRATUM_WORLD_CUTOVER_ENABLED="false"
STRATUM_WORLD_EVENT_MODEL="gpt-5.6-luna"
STRATUM_WORLD_THINKER_MODEL="gpt-5.6-terra"
STRATUM_WORLD_CRITIC_MODEL="gpt-5.6-terra"
STRATUM_WORLD_WEB_MODEL="gpt-5.6-terra"
MARKET_WORLD_MODEL_ENABLED="false"
# Leave automatic promotion disabled until real source ingestion, baseline
# compilation, hypothesis formation, and a contradictory-evidence revision have
# all been verified in this workspace.
MARKET_AUTO_THESIS_ENABLED="true"
# Encrypted Restic repository (for example, a private Backblaze B2 S3 bucket).
# The password file must be worker-only, mode 0600, and must not be in this repo.
RESTIC_REPOSITORY=""
RESTIC_PASSWORD_FILE=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_DEFAULT_REGION="us-west-001"
# Private Personal-account reconciliation. This is read-only, worker-only, and
# must never be copied into Vercel or browser environment variables.
ROBINHOOD_SYNC_ENABLED="false"
ROBINHOOD_MCP_URL="https://agent.robinhood.com/mcp/trading"
# Run `set -a; source .env.worker; set +a; node --experimental-strip-types
# scripts/robinhood-mcp-auth.ts` once on the private worker. The resulting
# OAuth credentials stay in this 0600 worker-local file, never in Vercel.
ROBINHOOD_MCP_OAUTH_STORE="/Users/agarwalaarush/.config/stratum/robinhood-mcp-oauth.json"
ROBINHOOD_MCP_OAUTH_PORT="1456"
ROBINHOOD_PORTFOLIO_OWNER_ID=""
ROBINHOOD_PORTFOLIO_NAME="Personal"
ROBINHOOD_ACCOUNT_NUMBER=""
