# Upstash Redis (cache tier)
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# Optional finance enrichments
FMP_API_KEY=""
FRED_API_KEY=""
SEC_API_USER_AGENT="Stratum/0.2 (your-email@example.com)"

# Alpaca server-only market data (never prefix these with NEXT_PUBLIC_)
ALPACA_API_KEY_ID=""
ALPACA_API_SECRET_KEY=""
ALPACA_DATA_FEED="delayed_sip"
ALPACA_TRADING_URL="https://paper-api.alpaca.markets"

# Optional GitHub auth for AI-research repo search rate limits
GITHUB_TOKEN=""

# OpenAI Responses API (article summaries)
OPENAI_API_KEY=""
OPENAI_ARTICLE_SUMMARY_MODEL="gpt-5.6-luna"
OPENAI_DAILY_OVERVIEW_MODEL="gpt-5.6-luna"
OPENAI_MORNING_BRIEF_MODEL="gpt-5.6-terra"
# Private worker model policy: candidate scouting is cheap; durable market
# research and critique stay on the stronger configured tier.
STRATUM_SOURCE_SCOUT_MODEL="gpt-5.6-luna"
STRATUM_MARKET_STANDARD_MODEL="gpt-5.6-terra"
STRATUM_MARKET_RESEARCH_MODEL="gpt-5.6-terra"
# Maximum unattended analyst-plus-critic pairs queued in one scheduler pass.
# Explicit user-requested research remains governed by its direct action.
STRATUM_MARKET_RESEARCH_RUN_LIMIT="2"

# Private World Thinker worker. Raw evidence remains under STRATUM_DATA_ROOT;
# this Git checkout contains synthesized state only.
STRATUM_DATA_ROOT="/Users/Shared/StratumData"
STRATUM_WORLD_ROOT="/Users/Shared/StratumData/world-model"
STRATUM_WORLD_GIT_REMOTE="git@github.com:AgarwalAarush/StratumWorld.git"
STRATUM_WORLD_BRANCH="shadow/world-thinker"
STRATUM_WORLD_THINKER_ENABLED="true"
STRATUM_WORLD_CUTOVER_ENABLED="false"
STRATUM_WORLD_EVENT_MODEL="gpt-5.6-luna"
STRATUM_WORLD_THINKER_MODEL="gpt-5.6-terra"
STRATUM_WORLD_CRITIC_MODEL="gpt-5.6-terra"
STRATUM_WORLD_WEB_MODEL="gpt-5.6-terra"

# Supabase (server-only persistence)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# Private Markets password session. Store a PBKDF2 hash, never the plaintext password.
MARKETS_ACCESS_PASSWORD_HASH=""
MARKETS_SESSION_SECRET=""
# Local visual verification only. Ignored in production.
MARKETS_AUTH_BYPASS="false"

# QStash signing keys (for cron job verification)
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# Optional: Render-hosted proxy for Google News URL decoding (avoids Vercel IP blocks)
GNEWS_PROXY_URL=""
GNEWS_PROXY_KEY=""
