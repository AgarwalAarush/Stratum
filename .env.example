# Upstash Redis (cache tier)
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# Optional finance enrichments
FMP_API_KEY=""
FRED_API_KEY=""
SEC_API_USER_AGENT="Stratum/0.2 (your-email@example.com)"

# Alpaca server-only market data (never prefix these with NEXT_PUBLIC_)
ALPACA_API_KEY_ID=""
ALPACA_API_SECRET_KEY=""
ALPACA_DATA_FEED="delayed_sip"
ALPACA_TRADING_URL="https://paper-api.alpaca.markets"

# Optional GitHub auth for AI-research repo search rate limits
GITHUB_TOKEN=""

# OpenAI Responses API (article summaries)
OPENAI_API_KEY=""
OPENAI_ARTICLE_SUMMARY_MODEL="gpt-5.6-luna"
OPENAI_DAILY_OVERVIEW_MODEL="gpt-5.6-luna"
OPENAI_MORNING_BRIEF_MODEL="gpt-5.6-terra"

# Supabase (overview persistence)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# QStash signing keys (for cron job verification)
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# Optional: Render-hosted proxy for Google News URL decoding (avoids Vercel IP blocks)
GNEWS_PROXY_URL=""
GNEWS_PROXY_KEY=""
