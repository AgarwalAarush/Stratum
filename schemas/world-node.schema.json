{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorldNode",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "title", "status", "asOf", "confidence", "importance", "aliases", "relationships", "sourceIds", "nextReviewAt", "summary", "claims", "indicators", "body"],
  "properties": {
    "id": { "type": "string", "minLength": 3, "maxLength": 160 },
    "kind": { "enum": ["actor", "situation", "theme", "market", "scenario", "hypothesis", "journal", "current"] },
    "title": { "type": "string", "minLength": 3, "maxLength": 300 },
    "status": { "enum": ["active", "monitoring", "dormant", "superseded", "archived"] },
    "asOf": { "type": "string", "format": "date-time" },
    "confidence": { "type": "integer", "minimum": 0, "maximum": 100 },
    "importance": { "type": "integer", "minimum": 0, "maximum": 100 },
    "aliases": { "type": "array", "maxItems": 30, "items": { "type": "string" } },
    "relationships": { "type": "array", "maxItems": 50, "items": { "type": "object", "additionalProperties": false, "required": ["type", "targetId", "description"], "properties": { "type": { "type": "string" }, "targetId": { "type": "string" }, "description": { "type": "string" } } } },
    "sourceIds": { "type": "array", "maxItems": 100, "items": { "type": "string" } },
    "nextReviewAt": { "type": "string", "format": "date-time" },
    "summary": { "type": "string", "minLength": 3, "maxLength": 2000 },
    "claims": { "type": "array", "maxItems": 50, "items": { "type": "object", "additionalProperties": false, "required": ["text", "sourceIds"], "properties": { "text": { "type": "string" }, "sourceIds": { "type": "array", "items": { "type": "string" } }, "assessment": { "type": "boolean" } } } },
    "indicators": { "type": "array", "maxItems": 30, "items": { "type": "object", "additionalProperties": false, "required": ["id", "label", "condition", "direction", "sourceIds"], "properties": { "id": { "type": "string" }, "label": { "type": "string" }, "condition": { "type": "string" }, "direction": { "enum": ["higher", "lower", "crosses", "changes"] }, "threshold": { "type": "string" }, "sourceIds": { "type": "array", "items": { "type": "string" } } } } },
    "body": { "type": "string", "minLength": 3, "maxLength": 16000 },
    "supersedes": { "type": "string" },
    "changeSummary": { "type": "string" },
    "probabilityRange": { "type": "object", "additionalProperties": false, "required": ["low", "high", "label"], "properties": { "low": { "type": "integer", "minimum": 0, "maximum": 100 }, "high": { "type": "integer", "minimum": 0, "maximum": 100 }, "label": { "const": "assessment" } } },
    "signposts": { "type": "array", "maxItems": 20, "items": { "type": "string" } },
    "mechanism": { "type": "string" }, "economicVariable": { "type": "string" }, "constrainedLayer": { "type": "string" }, "rentRecipient": { "type": "string" }, "expectationsQuestion": { "type": "string" },
    "catalysts": { "type": "array", "maxItems": 20, "items": { "type": "string" } }, "falsifiers": { "type": "array", "maxItems": 20, "items": { "type": "string" } }
  }
}
