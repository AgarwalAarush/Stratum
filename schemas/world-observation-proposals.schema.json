{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposals"],
  "properties": {
    "proposals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assertion", "kind", "mechanism", "evidenceQuote", "confidence", "materiality", "novelty"],
        "properties": {
          "assertion": { "type": "string", "minLength": 20, "maxLength": 700 },
          "kind": { "enum": ["fact", "estimate", "claim", "inference"] },
          "mechanism": { "type": "string", "minLength": 1, "maxLength": 100 },
          "evidenceQuote": { "type": "string", "minLength": 20, "maxLength": 1200 },
          "confidence": { "type": "integer", "minimum": 0, "maximum": 100 },
          "materiality": { "type": "integer", "minimum": 0, "maximum": 100 },
          "novelty": { "type": "integer", "minimum": 0, "maximum": 100 }
        }
      }
    }
  }
}
