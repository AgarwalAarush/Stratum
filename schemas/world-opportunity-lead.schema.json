    "dimensions": { "type": "object", "additionalProperties": false, "required": ["materiality", "transmissionConfidence", "capturePlausibility", "expectationsGap", "evidenceReadiness", "portfolioRelevance", "investability"], "properties": { "materiality": { "$ref": "#/definitions/score" }, "transmissionConfidence": { "$ref": "#/definitions/score" }, "capturePlausibility": { "$ref": "#/definitions/score" }, "expectationsGap": { "$ref": "#/definitions/score" }, "evidenceReadiness": { "$ref": "#/definitions/score" }, "portfolioRelevance": { "$ref": "#/definitions/score" }, "investability": { "$ref": "#/definitions/score" } } }
