{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorldEventClusterBatch",
  "type": "object",
  "additionalProperties": false,
  "required": ["clusters"],
  "properties": {
    "clusters": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fingerprint", "title", "actors", "geographies", "channels", "claimState", "materiality", "novelty", "summary", "sourceIds"],
        "properties": {
          "fingerprint": { "type": "string", "minLength": 8, "maxLength": 128 },
          "title": { "type": "string", "minLength": 3, "maxLength": 300 },
          "actors": { "type": "array", "maxItems": 20, "items": { "type": "string" } },
          "geographies": { "type": "array", "maxItems": 20, "items": { "type": "string" } },
          "channels": { "type": "array", "maxItems": 20, "items": { "type": "string" } },
          "claimState": { "enum": ["reported", "corroborated", "officially_confirmed", "contested", "retracted", "superseded"] },
          "materiality": { "type": "integer", "minimum": 0, "maximum": 100 },
          "novelty": { "type": "integer", "minimum": 0, "maximum": 100 },
          "summary": { "type": "string", "minLength": 3, "maxLength": 2000 },
          "sourceIds": { "type": "array", "minItems": 1, "maxItems": 40, "items": { "type": "string" } }
        }
      }
    }
  }
}
