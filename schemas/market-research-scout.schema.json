{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["leads", "unresolvedQuestions"],
  "properties": {
    "leads": {
      "type": "array", "minItems": 1, "maxItems": 12,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["title", "publisher", "url", "sourceType", "claim", "evidenceQuote", "supports", "limitations", "recurringSourceCandidate"],
        "properties": {
          "title": { "type": "string", "minLength": 4, "maxLength": 300 },
          "publisher": { "type": "string", "minLength": 2, "maxLength": 180 },
          "url": { "type": "string", "pattern": "^https://", "maxLength": 1200 },
          "sourceType": { "type": "string", "minLength": 3, "maxLength": 80 },
          "claim": { "type": "string", "minLength": 10, "maxLength": 1200 },
          "evidenceQuote": { "type": "string", "minLength": 8, "maxLength": 1000 },
          "supports": { "enum": ["supports", "contradicts", "context"] },
          "limitations": { "type": "array", "maxItems": 5, "items": { "type": "string", "minLength": 2, "maxLength": 300 } },
          "recurringSourceCandidate": { "type": "boolean" }
        }
      }
    },
    "unresolvedQuestions": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 4, "maxLength": 500 } }
  }
}
