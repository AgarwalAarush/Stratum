{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "businessSummary",
    "centralMarketQuestion",
    "marketThesis",
    "businessLines",
    "valueChain",
    "demandDrivers",
    "supplyConstraints",
    "causalChain",
    "marketStructure",
    "competitors",
    "strategicRelationships",
    "crossChecks",
    "expectations",
    "predictions",
    "falsifiers",
    "financialRole",
    "evidenceGaps",
    "confidence",
    "sourceIds"
  ],
  "properties": {
    "businessSummary": { "type": "string", "minLength": 1 },
    "centralMarketQuestion": { "type": "string", "minLength": 1 },
    "marketThesis": { "type": "string", "minLength": 1 },
    "businessLines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "offering", "customers", "jobToBeDone", "monetization", "maturity", "evidenceStatus", "sourceIds"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "offering": { "type": "string", "minLength": 1 },
          "customers": { "type": "string", "minLength": 1 },
          "jobToBeDone": { "type": "string", "minLength": 1 },
          "monetization": { "type": "string", "minLength": 1 },
          "maturity": { "enum": ["proven", "scaling", "emerging", "optionality"] },
          "evidenceStatus": { "$ref": "#/$defs/evidenceStatus" },
          "sourceIds": { "$ref": "#/$defs/sourceIds" }
        }
      }
    },
    "valueChain": {
      "type": "array",
      "minItems": 2,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["layer", "role", "companyPosition", "economics", "participants", "sourceIds"],
        "properties": {
          "layer": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "companyPosition": { "type": "string", "minLength": 1 },
          "economics": { "type": "string", "minLength": 1 },
          "participants": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
          "sourceIds": { "$ref": "#/$defs/sourceIds" }
        }
      }
    },
    "demandDrivers": { "$ref": "#/$defs/forces" },
    "supplyConstraints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "severity", "mechanism", "scarcityRentCapture", "resolutionSignals", "sourceIds"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["binding", "important", "watch", "not_established"] },
          "mechanism": { "type": "string", "minLength": 1 },
          "scarcityRentCapture": { "type": "string", "minLength": 1 },
          "resolutionSignals": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string" } },
          "sourceIds": { "$ref": "#/$defs/sourceIds" }
        }
      }
    },
    "causalChain": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "mechanism", "evidenceStatus", "sourceIds"],
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "mechanism": { "type": "string", "minLength": 1 },
          "evidenceStatus": { "$ref": "#/$defs/evidenceStatus" },
          "sourceIds": { "$ref": "#/$defs/sourceIds" }
        }
      }
    },
    "marketStructure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["marketDefinition", "pricingPower", "scarcityRentCapture", "cyclicality", "regulationAndPolicy"],
      "properties": {
        "marketDefinition": { "type": "string", "minLength": 1 },
        "pricingPower": { "type": "string", "minLength": 1 },
        "scarcityRentCapture": { "type": "string", "minLength": 1 },
        "cyclicality": { "type": "string", "minLength": 1 },
        "regulationAndPolicy": { "type": "string", "minLength": 1 }
      }
    },
    "competitors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "customerOverlap", "capability", "companyAdvantage", "companyGap", "implication", "sourceIds"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "customerOverlap": { "type": "string", "minLength": 1 },
          "capability": { "type": "string", "minLength": 1 },
          "companyAdvantage": { "type": "string", "minLength": 1 },
          "companyGap": { "type": "string", "minLength": 1 },
          "implication": { "type": "string", "minLength": 1 },
          "sourceIds": { "$ref": "#/$defs/sourceIds" }
        }
      }
    },
    "strategicRelationships": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entity", "relationship", "status", "economicMechanism", "thesisTreatment", "sourceIds"],
        "properties": {
          "entity": { "type": "string", "minLength": 1 },
          "relationship": { "type": "string", "minLength": 1 },
          "status": { "enum": ["verified", "company_claim", "analyst_inference", "unverified"] },
          "economicMechanism": { "type": "string", "minLength": 1 },
          "thesisTreatment": { "type": "string", "minLength": 1 },
          "sourceIds": { "$ref": "#/$defs/sourceIds" }
        }
      }
    },
    "crossChecks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method", "result", "implication", "sourceIds"],
        "properties": {
          "method": { "type": "string", "minLength": 1 },
          "result": { "type": "string", "minLength": 1 },
          "implication": { "type": "string", "minLength": 1 },
          "sourceIds": { "$ref": "#/$defs/sourceIds" }
        }
      }
    },
    "expectations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currentNarrative", "whatAppearsPriced", "variantView", "sourceIds"],
      "properties": {
        "currentNarrative": { "type": "string", "minLength": 1 },
        "whatAppearsPriced": { "type": "string", "minLength": 1 },
        "variantView": { "type": "string", "minLength": 1 },
        "sourceIds": { "$ref": "#/$defs/sourceIds" }
      }
    },
    "predictions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prediction", "horizon", "leadingIndicator", "confirmation", "disconfirmation", "sourceIds"],
        "properties": {
          "prediction": { "type": "string", "minLength": 1 },
          "horizon": { "type": "string", "minLength": 1 },
          "leadingIndicator": { "type": "string", "minLength": 1 },
          "confirmation": { "type": "string", "minLength": 1 },
          "disconfirmation": { "type": "string", "minLength": 1 },
          "sourceIds": { "$ref": "#/$defs/sourceIds" }
        }
      }
    },
    "falsifiers": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["condition", "observable", "thesisImpact", "sourceIds"],
        "properties": {
          "condition": { "type": "string", "minLength": 1 },
          "observable": { "type": "string", "minLength": 1 },
          "thesisImpact": { "type": "string", "minLength": 1 },
          "sourceIds": { "$ref": "#/$defs/sourceIds" }
        }
      }
    },
    "financialRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fundingCapacity", "monetizationProof", "valuationConstraint", "sourceIds"],
      "properties": {
        "fundingCapacity": { "type": "string", "minLength": 1 },
        "monetizationProof": { "type": "string", "minLength": 1 },
        "valuationConstraint": { "type": "string", "minLength": 1 },
        "sourceIds": { "$ref": "#/$defs/sourceIds" }
      }
    },
    "evidenceGaps": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 100 },
    "sourceIds": { "$ref": "#/$defs/sourceIds" }
  },
  "$defs": {
    "sourceIds": { "type": "array", "items": { "type": "string" } },
    "evidenceStatus": { "enum": ["observed", "company_claim", "analyst_inference", "unverified"] },
    "forces": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "direction", "mechanism", "horizon", "evidenceStatus", "sourceIds"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "direction": { "enum": ["tailwind", "headwind", "mixed"] },
          "mechanism": { "type": "string", "minLength": 1 },
          "horizon": { "type": "string", "minLength": 1 },
          "evidenceStatus": { "$ref": "#/$defs/evidenceStatus" },
          "sourceIds": { "$ref": "#/$defs/sourceIds" }
        }
      }
    }
  }
}
