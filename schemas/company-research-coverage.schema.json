{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "topics",
    "sources"
  ],
  "properties": {
    "sources": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "title",
          "publishedAt"
        ],
        "properties": {
          "url": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "publishedAt": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "topics": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "importance",
          "decisive",
          "evidence",
          "unresolvedQuestions"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "importance": {
            "type": "string"
          },
          "decisive": {
            "type": "boolean"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "url",
                "quote"
              ],
              "properties": {
                "url": {
                  "type": "string"
                },
                "quote": {
                  "type": "string",
                  "minLength": 20,
                  "maxLength": 1500
                }
              }
            }
          },
          "unresolvedQuestions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
