{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formalRating",
    "entryAction",
    "investmentThesis",
    "keyDebate",
    "mispricing",
    "fastestKillSignal",
    "fairValue",
    "entryZoneLow",
    "entryZoneHigh",
    "confidence",
    "revision",
    "sections",
    "sourceIds"
  ],
  "properties": {
    "formalRating": { "enum": ["BUY", "HOLD", "SELL"] },
    "entryAction": { "enum": ["buy_now", "nibble", "wait", "add_on_weakness", "avoid"] },
    "investmentThesis": { "type": "string", "minLength": 1 },
    "keyDebate": { "type": "string", "minLength": 1 },
    "mispricing": { "type": "string", "minLength": 1 },
    "fastestKillSignal": { "type": "string", "minLength": 1 },
    "fairValue": { "type": ["number", "null"] },
    "entryZoneLow": { "type": ["number", "null"] },
    "entryZoneHigh": { "type": ["number", "null"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 100 },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priorVersion", "opinionChange", "summary", "changes"],
      "properties": {
        "priorVersion": { "type": ["integer", "null"], "minimum": 1 },
        "opinionChange": {
          "enum": ["initial", "more_constructive", "less_constructive", "unchanged"]
        },
        "summary": { "type": "string", "minLength": 1 },
        "changes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "previous", "current", "explanation"],
            "properties": {
              "field": {
                "enum": [
                  "formal_rating",
                  "entry_action",
                  "fair_value",
                  "investment_thesis",
                  "key_debate",
                  "kill_criteria",
                  "evidence"
                ]
              },
              "previous": { "type": "string" },
              "current": { "type": "string" },
              "explanation": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "content", "sourceIds"],
        "properties": {
          "id": {
            "enum": [
              "snapshot",
              "business_model_and_moat",
              "financial_profile",
              "market_and_competition",
              "growth_drivers",
              "management_and_capital_allocation",
              "valuation",
              "catalysts",
              "bull_case",
              "base_case",
              "bear_case",
              "risk_factors",
              "sentiment_and_positioning",
              "verdict",
              "kill_criteria"
            ]
          },
          "title": { "type": "string", "minLength": 1 },
          "content": { "type": "string", "minLength": 1 },
          "sourceIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "sourceIds": { "type": "array", "items": { "type": "string" } }
  }
}
