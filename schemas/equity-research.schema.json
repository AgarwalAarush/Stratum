{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formalRating",
    "entryAction",
    "investmentThesis",
    "keyDebate",
    "mispricing",
    "fastestKillSignal",
    "fairValue",
    "entryZoneLow",
    "entryZoneHigh",
    "confidence",
    "revision",
    "sections",
    "sourceIds",
    "advice"
  ],
  "properties": {
    "formalRating": {
      "enum": [
        "BUY",
        "HOLD",
        "SELL"
      ]
    },
    "entryAction": {
      "enum": [
        "buy_now",
        "nibble",
        "wait",
        "add_on_weakness",
        "avoid"
      ]
    },
    "investmentThesis": {
      "type": "string",
      "minLength": 1
    },
    "keyDebate": {
      "type": "string",
      "minLength": 1
    },
    "mispricing": {
      "type": "string",
      "minLength": 1
    },
    "fastestKillSignal": {
      "type": "string",
      "minLength": 1
    },
    "fairValue": {
      "type": [
        "number",
        "null"
      ]
    },
    "entryZoneLow": {
      "type": [
        "number",
        "null"
      ]
    },
    "entryZoneHigh": {
      "type": [
        "number",
        "null"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priorVersion",
        "opinionChange",
        "summary",
        "changes"
      ],
      "properties": {
        "priorVersion": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "opinionChange": {
          "enum": [
            "initial",
            "more_constructive",
            "less_constructive",
            "unchanged"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "changes": {
          "type": "array",
          "minItems": 0,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "previous",
              "current",
              "explanation"
            ],
            "properties": {
              "field": {
                "enum": [
                  "formal_rating",
                  "entry_action",
                  "fair_value",
                  "investment_thesis",
                  "key_debate",
                  "kill_criteria",
                  "evidence"
                ]
              },
              "previous": {
                "type": "string"
              },
              "current": {
                "type": "string"
              },
              "explanation": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "content",
          "sourceIds"
        ],
        "properties": {
          "id": {
            "enum": [
              "snapshot",
              "business_model_and_moat",
              "financial_profile",
              "market_and_competition",
              "growth_drivers",
              "management_and_capital_allocation",
              "valuation",
              "catalysts",
              "bull_case",
              "base_case",
              "bear_case",
              "risk_factors",
              "sentiment_and_positioning",
              "verdict",
              "kill_criteria"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "sourceIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "advice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "businessView",
        "evidenceSufficiency",
        "newEntryStance",
        "existingPositionStance",
        "decisionSupport"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "enum": [
            2
          ]
        },
        "businessView": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "reason",
            "sourceIds",
            "changeConditions"
          ],
          "properties": {
            "value": {
              "enum": [
                "constructive",
                "mixed",
                "adverse",
                "undetermined"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 8
            },
            "sourceIds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "changeConditions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 8
              }
            }
          }
        },
        "evidenceSufficiency": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "reason",
            "sourceIds",
            "changeConditions"
          ],
          "properties": {
            "value": {
              "enum": [
                "sufficient",
                "limited",
                "insufficient"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 8
            },
            "sourceIds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "changeConditions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 8
              }
            }
          }
        },
        "newEntryStance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "reason",
            "sourceIds",
            "changeConditions"
          ],
          "properties": {
            "value": {
              "enum": [
                "eligible",
                "wait",
                "avoid",
                "undetermined"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 8
            },
            "sourceIds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "changeConditions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 8
              }
            }
          }
        },
        "existingPositionStance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "reason",
            "sourceIds",
            "changeConditions"
          ],
          "properties": {
            "value": {
              "enum": [
                "retain",
                "reduce",
                "exit",
                "undetermined"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 8
            },
            "sourceIds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "changeConditions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 8
              }
            }
          }
        },
        "decisionSupport": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidenceGaps",
            "actionSupport",
            "scenarios",
            "followUp"
          ],
          "properties": {
            "evidenceGaps": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "question",
                  "kind",
                  "dataKeys",
                  "blockingActions",
                  "sourceIds",
                  "followUp"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 3
                  },
                  "question": {
                    "type": "string",
                    "minLength": 8
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "missing_fact",
                      "capture_failure",
                      "undisclosed_metric",
                      "future_uncertainty"
                    ]
                  },
                  "dataKeys": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "blockingActions": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "buy",
                        "add",
                        "hold",
                        "trim",
                        "sell"
                      ]
                    }
                  },
                  "sourceIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "followUp": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "trigger",
                      "nextCheckAt"
                    ],
                    "properties": {
                      "trigger": {
                        "type": "string",
                        "minLength": 8
                      },
                      "nextCheckAt": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  }
                }
              }
            },
            "actionSupport": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "buy",
                "add",
                "hold",
                "trim",
                "sell"
              ],
              "properties": {
                "buy": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status",
                    "reason",
                    "sourceIds",
                    "reviewedGapIds",
                    "reversalConditions"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "supported",
                        "unresolved"
                      ]
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 40
                    },
                    "sourceIds": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    },
                    "reviewedGapIds": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "reversalConditions": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 8
                      }
                    }
                  }
                },
                "add": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status",
                    "reason",
                    "sourceIds",
                    "reviewedGapIds",
                    "reversalConditions"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "supported",
                        "unresolved"
                      ]
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 40
                    },
                    "sourceIds": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    },
                    "reviewedGapIds": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "reversalConditions": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 8
                      }
                    }
                  }
                },
                "hold": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status",
                    "reason",
                    "sourceIds",
                    "reviewedGapIds",
                    "reversalConditions"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "supported",
                        "unresolved"
                      ]
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 40
                    },
                    "sourceIds": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    },
                    "reviewedGapIds": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "reversalConditions": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 8
                      }
                    }
                  }
                },
                "trim": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status",
                    "reason",
                    "sourceIds",
                    "reviewedGapIds",
                    "reversalConditions"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "supported",
                        "unresolved"
                      ]
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 40
                    },
                    "sourceIds": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    },
                    "reviewedGapIds": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "reversalConditions": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 8
                      }
                    }
                  }
                },
                "sell": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status",
                    "reason",
                    "sourceIds",
                    "reviewedGapIds",
                    "reversalConditions"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "supported",
                        "unresolved"
                      ]
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 40
                    },
                    "sourceIds": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    },
                    "reviewedGapIds": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "reversalConditions": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 8
                      }
                    }
                  }
                }
              }
            },
            "scenarios": {
              "type": "array",
              "minItems": 2,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "assumptions",
                  "implication",
                  "sourceIds"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "enum": [
                      "base",
                      "downside",
                      "upside"
                    ]
                  },
                  "assumptions": {
                    "type": "string",
                    "minLength": 8
                  },
                  "implication": {
                    "type": "string",
                    "minLength": 8
                  },
                  "sourceIds": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "followUp": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "trigger",
                "nextCheckAt"
              ],
              "properties": {
                "trigger": {
                  "type": "string",
                  "minLength": 8
                },
                "nextCheckAt": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
